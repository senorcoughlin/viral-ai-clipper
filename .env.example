# Free AI stack
GROQ_API_KEY=gsk_...          # https://console.groq.com
GEMINI_API_KEY=AIza...        # https://aistudio.google.com/apikey

# Existing
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
BLOB_READ_WRITE_TOKEN=...

# Black Friday 2026 sale prices (regular prices stay in STRIPE_PRICE_MONTHLY / STRIPE_PRICE_YEARLY).
# Checkout uses these only while the offer is active (through Jan 1, 2027 23:59 ET).
STRIPE_PRICE_BF_MONTHLY=price_...
STRIPE_PRICE_BF_YEARLY=price_...

# Residential proxy for blocked YouTube downloads and live HLS only. Never log this value.
YT_PROXY_URL=

# RenderIO (Pro plan: 5,000 included commands; overage billed per command).
# Cycle day is the plan anniversary in America/New_York (default 24).
# When estimated overage reaches RENDERIO_OVERAGE_BUDGET_USD, clips use local ffmpeg.
# RENDERIO_API_KEY=
# RENDERIO_PLAN_COMMANDS=5000
# RENDERIO_OVERAGE_USD_PER_CMD=0.057
# RENDERIO_OVERAGE_BUDGET_USD=35
# RENDERIO_CYCLE_DAY=24
